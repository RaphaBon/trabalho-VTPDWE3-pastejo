# Testes de pastos. Rode o login primeiro.
### Necessário para pegar o token
### Post
# @name loginAutenticado
POST http://localhost:40000/Login HTTP/1.1
content-type: application/json

{
    "username": "qwe",
    "password": "qwe"
}
### Seta o token
# Guarda o token do login para as próximas requisições.
@accessToken = {{loginAutenticado.response.body.$.token}}
@username = {{loginAutenticado.response.body.$.username}}


### teste de buscar todos os pastos
GET http://localhost:40000/getAllPastos HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

{

}

### teste de buscar pasto por ID
GET http://localhost:40000/getPastoByID/1 HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

### teste de inserção de pasto
POST http://localhost:40000/insertPasto HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

{
    "pastoid": 0,
    "descricao": "Pasto da Baixada",
    "areatotal": 35.20,
    "removido": false
}

### teste de atualização de pasto
PUT http://localhost:40000/updatePasto/3 HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

{
    "descricao": "xPasto da Baixada",
    "areatotal": 36.40,
    "removido": false
}

### teste de remoção de pasto
DELETE http://localhost:40000/deletePasto/3 HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}

