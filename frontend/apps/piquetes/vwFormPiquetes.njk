{# Formulário de piquetes, com Select2 para o pasto. #}
{% extends "layout.njk" %}


{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulario de piquetes</h1>
    <p class="text-secondary mb-0">Manipule os piquetes de cada pasto.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Dados do piquete</h2>
          <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover um piquete.</p>
        </div>
      </div>

      <form id="frmPiquetes" data-servidor-dw3="{{ servidorDw3 }}">
        {# ID e removido ficam ocultos. #}
        <input type="hidden" id="piqueteid" name="piqueteid" value="0">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="descricao" class="form-label">Descrição</label>
            <input type="text" class="form-control" id="descricao" name="descricao" value="" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="latitude" class="form-label">Latitude</label>
            <input type="number" class="form-control" id="latitude" name="latitude" min="-90" max="90" step="0.000001" value="" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="longitude" class="form-label">Longitude</label>
            <input type="number" class="form-control" id="longitude" name="longitude" min="-180" max="180" step="0.000001" value="" required>
          </div>

          <div class="col-12">
            <label for="pastoidfk" class="form-label">Pasto</label>
            {# Vira Select2; opções vêm de /getPastosToPiquetes. #}
            <select class="form-select" id="pastoidfk" name="pastoidfk" required>
              <option value="">Selecione um pasto</option>
            </select>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirPiquete">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarPiquete" disabled>
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPiquete">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/piquetes" id="btnFecharPiquete">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  {# Select2 precisa do jQuery. #}
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="/apps/piquetes/vwFormPiquetes.js"></script>
{% endblock %}
