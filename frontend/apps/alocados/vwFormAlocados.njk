{# Formulário de alocações, com Select2 para o animal e para o piquete. #}
{% extends "layout.njk" %}


{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulario de alocações</h1>
    <p class="text-secondary mb-0">Manipule as alocações dos animais nos piquetes.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Dados da alocação</h2>
          <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover uma alocação.</p>
        </div>
      </div>

      <form id="frmAlocados" data-servidor-dw3="{{ servidorDw3 }}">
        {# ID e removido ficam ocultos. #}
        <input type="hidden" id="alocadoid" name="alocadoid" value="0">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="animalidifk" class="form-label">Animal</label>
            {# Vira Select2; opções vêm de /getAnimaisToAlocados. #}
            <select class="form-select" id="animalidifk" name="animalidifk" required>
              <option value="">Selecione um animal</option>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label for="piqueteidfk" class="form-label">Piquete</label>
            {# Vira Select2; opções vêm de /getPiquetesToAlocados. #}
            <select class="form-select" id="piqueteidfk" name="piqueteidfk" required>
              <option value="">Selecione um piquete</option>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label for="datainicio" class="form-label">Data Início</label>
            <input type="date" class="form-control" id="datainicio" name="datainicio" value="" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="datafinal" class="form-label">Data Final</label>
            {# Opcional: vazio = animal ainda no piquete. #}
            <input type="date" class="form-control" id="datafinal" name="datafinal" value="">
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirAlocado">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarAlocado" disabled>
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverAlocado">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/alocados" id="btnFecharAlocado">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  {# Select2 precisa do jQuery. #}
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="/apps/alocados/vwFormAlocados.js"></script>
{% endblock %}
